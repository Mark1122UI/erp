# ==============================================================================
# UNIVERSAL ERP — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Safe placeholder template. Copy to .env and set secure production values.
# NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=3000
APP_NAME=Universal-ERP
APP_URL=https://erp.example.com

# MongoDB Production Connection
# Use a secure replica set connection string with TLS and authentication
MONGODB_URI=mongodb+srv://erp_app_user:REPLACE_WITH_SECURE_PASSWORD@cluster0.example.mongodb.net/universal_erp_prod?retryWrites=true&w=majority

# JWT & Authentication Security (Minimum 64 characters high-entropy random string)
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_CHAR_CRYPTOGRAPHIC_RANDOM_SECRET_KEY_HERE_123456
JWT_EXPIRES_IN=7d

# Session Cookie Security
COOKIE_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_CRYPTOGRAPHIC_RANDOM_COOKIE_SECRET_KEY
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# CORS Allowed Origins (Comma-separated list of production domain URLs)
CORS_ORIGIN=https://erp.example.com,https://pos.example.com

# Rate Limiting Configuration
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_API_MAX=200
RATE_LIMIT_API_WINDOW_MS=60000

# File Upload & Document Storage
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Integration & Webhook Signing Keys (Optional / Feature-specific)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET
SHOPIFY_WEBHOOK_SECRET=shsec_REPLACE_WITH_SHOPIFY_WEBHOOK_SIGNING_SECRET
SENDGRID_API_KEY=SG.REPLACE_WITH_SENDGRID_PRODUCTION_KEY
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=Universal ERP <noreply@erp.example.com>
